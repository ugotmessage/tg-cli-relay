# 通用範本。第一組（Cursor + /srv/docker）建議直接複製：
#   cp deploy/env.group1-cursor.example .env
# 再編輯 TELEGRAM_BOT_TOKEN 等敏感欄位。

# Session 對照表（SQLite）
TGR_SESSION_DB=data/sessions.sqlite3

# 預設要讓代理操作的工作目錄（單一 git repo 較保險）
TGR_DEFAULT_WORKSPACE=/path/to/git/repo

# Cursor Agent CLI 可執行檔（預設 agent）
TGR_CURSOR_AGENT_BIN=agent
# Cursor relay 預設模型（建議維持 auto；僅影響本 bot 的 agent 呼叫）
# TGR_CURSOR_MODEL=auto
# Cursor agent 單輪逾時（秒）；0 表示不限制。TG relay 建議 600，避免 tail -f 等無限等待
# TGR_CURSOR_TIMEOUT=600
# Task Router 設定檔；遺失或錯誤會自動 fallback 到內建 rule-based 規則
# TGR_ROUTER_CONFIG=router.toml
# 模糊追問時，將本對話最多 8 個任務摘要交給目前的主 Agent CLI 判斷；不需 MCP
# 僅在模糊且可能有關聯的訊息呼叫；設 0 可恢復原本列清單的行為
# TGR_TASK_CONTEXT_RESOLVER=1
# 設為 0 可關閉 Cursor prompt 前綴；TGR_CURSOR_PROMPT_PREFIX 可完全覆寫前綴
# TGR_CURSOR_HARNESS_PREFIX=1
# TGR_CURSOR_PROMPT_PREFIX=
# OpenAI Codex CLI（預設 codex）；僅當 TGR_BACKEND=codex 時會用到，與 Cursor 無關
# TGR_CODEX_BIN=codex
# Codex 原生 App Server（選用；預設 cli / codex exec，避免影響既有部署）
# TGR_CODEX_TRANSPORT=app-server
# TGR_CODEX_APP_TURN_TIMEOUT=7200
# TGR_CODEX_APP_STEER=1
# TGR_CODEX_APP_SANDBOX=workspace-write
# Worker 選擇：auto 偵測 Cursor，否則使用 Codex 原生能力（或自行處理）
# 選項：auto | native | off | cursor | claude | opencode
# TGR_WORKER_PROVIDER=auto

# 設為 1 可讓 Codex 跳過核准與 sandbox，適合已隔離的無人值守場景；預設關閉
# TGR_CODEX_BYPASS_APPROVALS_AND_SANDBOX=1
# Claude Code CLI（預設 claude）；僅當 TGR_BACKEND=claude 時會用到
# TGR_CLAUDE_BIN=claude
# 設為 1 可讓 Claude CLI 跳過工具授權提示，適合無人值守場景；預設關閉
# TGR_CLAUDE_SKIP_PERMISSIONS=1
# OpenCode CLI（預設 opencode）；僅當 TGR_BACKEND=opencode 時會用到
# TGR_OPENCODE_BIN=opencode

# Cursor Agent：一般用「同一使用者」執行 agent login（OAuth）；僅在你要用 API key 模式時才設定
# CURSOR_API_KEY=

# --- Telegram bot（選用，需 pip install -e ".[telegram]"）---
# TELEGRAM_BOT_TOKEN=
# 逗號分隔的 user id；留空則不限制（不建議正式環境）
# TGR_ALLOWED_TELEGRAM_USER_IDS=123456,789012
# Telegram 長連線 timeout（秒）
# TGR_TELEGRAM_CONNECT_TIMEOUT=30
# TGR_TELEGRAM_READ_TIMEOUT=60
# Telegram fallback IP（逗號分隔）；留空時會自動 DoH 探測
# TGR_TELEGRAM_FALLBACK_IPS=149.154.166.110,149.154.167.220
# Telegram 專用 proxy（例如 socks5://127.0.0.1:7890）
# TGR_TELEGRAM_PROXY=
# 第一組目前使用 Cursor
TGR_BACKEND=cursor
# Telegram 中可切換的 providers；留空時顯示全部支援後端
# TGR_ENABLED_BACKENDS=claude,codex
# TGR_LOG_LEVEL=INFO

# --- Telegram 附件收發 ---
# 下載暫存目錄（bot-fingerprint/chat-id/message-id/）
# TGR_UPLOAD_DIR=~/.hermes/tg-relay-uploads
# TGR_MAX_DOWNLOAD_BYTES=20971520
# TGR_MAX_UPLOAD_BYTES=20971520
# TGR_MAX_FILES_PER_MESSAGE=5
# TGR_UPLOAD_RETENTION_HOURS=72
# 逗號分隔 MIME allowlist；留空用內建預設
# TGR_ALLOWED_DOWNLOAD_MIME_TYPES=text/plain,application/pdf
# 出站 TGR_FILE: 允許根目錄（逗號分隔）；Codex 範例：
# TGR_ALLOWED_UPLOAD_ROOTS=~/.hermes/tg-relay-uploads,~/.hermes/codex-relay/artifacts

# Telegram /force 與 /stop：所有 CLI 均可使用；Codex App Server 可原生即時 steer。
# 每次服務啟動時，Bot 會重新呼叫 Telegram set_my_commands 更新指令選單。
