# 通用範本。第一組（Cursor + /srv/docker）建議直接複製：
#   cp deploy/env.group1-cursor.example .env
# 再編輯 TELEGRAM_BOT_TOKEN 等敏感欄位。

# Session 對照表（SQLite）
TGR_SESSION_DB=/srv/tg-cli-relay/data/sessions.sqlite3

# 預設要讓代理操作的工作目錄（單一 git repo 較保險）
TGR_DEFAULT_WORKSPACE=/srv/docker

# 可執行檔名稱或絕對路徑
TGR_CURSOR_AGENT_BIN=agent
TGR_CODEX_BIN=codex

# Cursor Agent 常用（依官方文件為準）
# CURSOR_API_KEY=

# --- Telegram bot（選用，需 pip install -e ".[telegram]"）---
# TELEGRAM_BOT_TOKEN=
# 逗號分隔的 user id；留空則不限制（不建議正式環境）
# TGR_ALLOWED_TELEGRAM_USER_IDS=123456,789012
# 第一組目前使用 Cursor
TGR_BACKEND=cursor
# TGR_LOG_LEVEL=INFO
