# WEB1 verified completion callback (placeholders only; never commit real secrets).
# Copy to the group-2 env file or EnvironmentFile, then generate a secret outside git.
#
#   openssl rand -out /etc/tg-cli-relay/callback.secret 32
#   chmod 0600 /etc/tg-cli-relay/callback.secret
#   chown root:root /etc/tg-cli-relay/callback.secret
#   install -d -m 0700 /var/lib/tg-cli-relay/callback

# Default OFF. Unset / 0 / false / no / off all disable registration, receive, and the inbox loop.
TGR_BACKGROUND_HANDOFF=0
TGR_BACKGROUND_HANDOFF_STATE_ROOT=/var/lib/tg-cli-relay/callback
TGR_BACKGROUND_HANDOFF_SECRET_FILE=/etc/tg-cli-relay/callback.secret
TGR_BACKGROUND_HANDOFF_MAX_SKEW_SECONDS=86400

# Local shared-watcher handoff verification (required for intentional detach).
# Must name the readable existing watcher queue, not a new queue/daemon.
TGR_BACKGROUND_HANDOFF_QUEUE_ROOT=/var/lib/hms/cursor-worker-watchdog/queue
# Give each bot a separate callback state root, outside the service cwd Git repo.
# Dual-bot HMS launcher template: deploy/hms/run-cursor-worker-watchdog.sh.example
