# 第一組：Telegram Bot → Cursor agent（複製本檔為 deploy/env.group1-cursor 或合併進 .env）
#
# 注意：TGR_DEFAULT_WORKSPACE 最好是「單一 git 專案根目錄」。
# 請依部署環境改成實際 repo 路徑；不要把特定主機路徑寫進程式碼。

TGR_SESSION_DB=data/sessions.group1-cursor.sqlite3
TGR_DEFAULT_WORKSPACE=/path/to/git/repo
TGR_BACKEND=cursor

# Cursor 走「agent」；「codex」是另一套 OpenAI CLI，僅 TGR_BACKEND=codex 時才需要 TGR_CODEX_BIN
TGR_CURSOR_AGENT_BIN=agent
TGR_CURSOR_DELEGATE_TIMEOUT=3600

# Cursor Agent：與執行 bot 相同使用者下執行 agent login（OAuth）即可；僅 API key 模式需要下列變數
# CURSOR_API_KEY=

# Telegram（python3 -m tg_cli_relay bot）
# TELEGRAM_BOT_TOKEN=
# 建議正式環境務必設定白名單（逗號分隔數字 user id）
# TGR_ALLOWED_TELEGRAM_USER_IDS=

TGR_LOG_LEVEL=INFO

# --- Telegram 附件（選用）---
# TGR_UPLOAD_DIR=~/.hermes/tg-relay-uploads
# TGR_ALLOWED_UPLOAD_ROOTS=~/.hermes/tg-relay-uploads,~/.hermes/codex-relay/artifacts
