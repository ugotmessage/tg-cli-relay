# 第一組：Telegram Bot → Cursor agent（複製本檔為 deploy/env.group1-cursor 或合併進 .env）
#
# 注意：TGR_DEFAULT_WORKSPACE 最好是「單一 git 專案根目錄」。
# /srv/docker 若為多專案父目錄且非 git root，agent 可能拒絕或行為異常；
# 屆時請改為例如 /srv/docker/line-pic-bot 等實際 repo 路徑。

TGR_SESSION_DB=/srv/tg-cli-relay/data/sessions.group1-cursor.sqlite3
TGR_DEFAULT_WORKSPACE=/srv/docker
TGR_BACKEND=cursor

# Cursor 走「agent」；「codex」是另一套 OpenAI CLI，僅 TGR_BACKEND=codex 時才需要 TGR_CODEX_BIN
TGR_CURSOR_AGENT_BIN=agent

# Cursor Agent 認證（依官方文件）
# CURSOR_API_KEY=

# Telegram（python3 -m tg_cli_relay bot）
# TELEGRAM_BOT_TOKEN=
# 建議正式環境務必設定白名單（逗號分隔數字 user id）
# TGR_ALLOWED_TELEGRAM_USER_IDS=

TGR_LOG_LEVEL=INFO
