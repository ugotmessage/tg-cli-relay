# 第二組：Telegram Bot → Cursor（與第一組 bot token 分開）
# 複製並填入：
#   cp deploy/env.group2-claude-codex.example deploy/env.group2-claude-codex
# 可選 API Key（不入版控）：
#   echo 'CURSOR_API_KEY=cursor_...' > deploy/env.group2.secrets && chmod 600 deploy/env.group2.secrets

TGR_SESSION_DB=/srv/tg-cli-relay/data/group2/sessions.sqlite3
TGR_DEFAULT_WORKSPACE=/srv/docker
TGR_KNOWLEDGE_DIR=/srv/docker/knowledge
TGR_BACKEND=cursor
TGR_ENABLED_BACKENDS=cursor

TGR_CURSOR_AGENT_BIN=/root/.local/bin/agent
TGR_CURSOR_MODEL=claude-4.6-sonnet-medium

# Cursor：CURSOR_API_KEY（deploy/env.group2.secrets）或 root 執行 agent login（OAuth）

# --- Telegram（必須與第一組不同的 BotFather token）---
TELEGRAM_BOT_TOKEN=
# TGR_ALLOWED_TELEGRAM_USER_IDS=123456,789012

TGR_LOG_LEVEL=INFO
