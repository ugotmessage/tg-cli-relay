# Claude Code CLI 部署範本（複製本檔為 deploy/env.claude 或合併進 .env）
#
# 認證方式二選一：
#   A) OAuth（claude login）：在執行 bot 的同一使用者環境下執行一次 `claude login`，
#      憑證存於 ~/.claude/；systemd 的 User= 必須與登入帳號一致。
#   B) API Key：取消下方 ANTHROPIC_API_KEY 的註解並填入金鑰，
#      無需 claude login，適合 server 部署與無人值守。

TGR_SESSION_DB=/srv/tg-cli-relay/data/sessions.claude.sqlite3
TGR_DEFAULT_WORKSPACE=/srv/your-repo
TGR_BACKEND=claude

# Claude Code CLI 可執行檔（預設 claude）
# TGR_CLAUDE_BIN=claude

# 設為 1 讓 Claude CLI 跳過所有工具授權確認（無人值守必要，僅在已隔離環境使用）
TGR_CLAUDE_SKIP_PERMISSIONS=1

# --- 認證 ---
# 方式 B：API Key（與 claude login 擇一）
# ANTHROPIC_API_KEY=sk-ant-...

# --- Telegram ---
# TELEGRAM_BOT_TOKEN=
# 建議正式環境務必設定白名單（逗號分隔數字 user id）
# TGR_ALLOWED_TELEGRAM_USER_IDS=

TGR_LOG_LEVEL=INFO
