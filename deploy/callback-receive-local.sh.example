#!/bin/bash
# Local relay receiver wrapper. Arguments are paths, never secret values.
set -euo pipefail
umask 077

if [[ "$#" -ne 2 ]]; then
  echo "misconfigured" >&2
  exit 4
fi

ENV_FILE="$1"
PYTHON_BIN="$2"
if [[ "$ENV_FILE" != /* || "$PYTHON_BIN" != /* || ! -f "$ENV_FILE" || -L "$ENV_FILE" || ! -x "$PYTHON_BIN" ]]; then
  echo "misconfigured" >&2
  exit 4
fi

set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

exec "$PYTHON_BIN" -m tg_cli_relay callback-receive
