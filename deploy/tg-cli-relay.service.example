[Unit]
Description=tg-cli-relay 第一組（Telegram → Cursor，工作目錄見環境檔）
After=network-online.target

[Service]
Type=simple
# Cursor OAuth（agent login）憑證綁在登入者的家目錄；User= 必須與當初執行 agent login 的使用者一致
# User=youruser
WorkingDirectory=/srv/tg-cli-relay
# 可擇一：專案根 .env，或 cp deploy/env.group1-cursor.example deploy/env.group1-cursor 後改下列路徑
EnvironmentFile=-/srv/tg-cli-relay/.env
# EnvironmentFile=-/srv/tg-cli-relay/deploy/env.group1-cursor
# 確保能找到 agent / codex（依實際安裝路徑調整）
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/root/.local/bin:/root/.nvm/versions/node/v22.22.1/bin
ExecStart=/srv/tg-cli-relay/.venv/bin/python3 -m tg_cli_relay bot
Restart=on-failure

[Install]
WantedBy=multi-user.target
